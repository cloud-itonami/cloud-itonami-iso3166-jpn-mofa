 {:source/id "register.coverage"
  :source/kind :coverage
  :coverage/entries 26
  :coverage/by-verify {:http-2xx 15 :e-gov-law-id 11}
  :coverage/publishers #{"Ministry of Foreign Affairs of Japan" "JICA"
